{
  "version": 1,
  "note": "Editorial title table for the anatomy_structures stage. Built by etl/reference/build_anatomy_structure_titles.py -- never hand-edited. `titles` is rung 1 (exact articles the ladder cannot find); `broader` is rung 7, tried only after every exact rung fails, and ships as scope=broader; `rejected` records names with no article.",
  "families": [
    {
      "pattern": "\\bnodes?\\)?$",
      "title": "Lymph node",
      "matched": 105,
      "why": "TA2 names ~90 named lymph-node groups; Wikipedia documents them in the lymph-node article and a handful of regional ones."
    },
    {
      "pattern": "\\bbursae?$",
      "title": "Synovial bursa",
      "matched": 17,
      "why": "68 named bursae, one article."
    },
    {
      "pattern": "\\bbronchus\\b",
      "title": "Bronchus",
      "matched": 56,
      "why": "The segmental bronchi are named individually in TA2 and collectively on Wikipedia (the qualifier can trail: '... of left lung (BVIII)')."
    },
    {
      "pattern": "\\bbronchopulmonary segment\\b",
      "title": "Bronchopulmonary segment",
      "matched": 20,
      "why": "Likewise the ten segments per lung."
    },
    {
      "pattern": "^nucleus pulposus\\b",
      "title": "Nucleus pulposus",
      "matched": 23,
      "why": "One nucleus pulposus per disc, one article."
    },
    {
      "pattern": "\\bspinal cord segment$",
      "title": "Spinal cord",
      "matched": 21,
      "why": "31 segments, described together in the spinal-cord article."
    },
    {
      "pattern": "\\bretinacul(um|a)$",
      "title": "Retinaculum",
      "matched": 4,
      "why": "The named retinacula share one article."
    },
    {
      "pattern": "\\bconjunctiva\\b",
      "title": "Conjunctiva",
      "matched": 6,
      "why": "Bulbar and palpebral conjunctiva, per eyelid, share one article."
    },
    {
      "pattern": "^cervical vertebra|^vertebra c\\d",
      "title": "Cervical vertebrae",
      "matched": 5,
      "why": "The seven cervical vertebrae are one article."
    },
    {
      "pattern": "^thoracic vertebra|^vertebra t\\d",
      "title": "Thoracic vertebrae",
      "matched": 24,
      "why": "As above."
    },
    {
      "pattern": "^lumbar vertebra|^vertebra l\\d",
      "title": "Lumbar vertebrae",
      "matched": 11,
      "why": "As above."
    },
    {
      "pattern": "^intervertebral disc\\b",
      "title": "Intervertebral disc",
      "matched": 23,
      "why": "As above."
    },
    {
      "pattern": "\\bpapillary muscle\\b",
      "title": "Papillary muscle",
      "matched": 8,
      "why": "The heart's papillary muscles are named per ventricle, head and cusp in the models; Wikipedia describes them in one article."
    },
    {
      "pattern": "^(costal cartilage|rib) ",
      "title": "Rib cage",
      "matched": 10,
      "why": "Numbered ribs and their cartilages are described in the rib-cage article."
    }
